   {
     "name": "sipelang",
     "main": "gate-worker.js",
     "compatibility_date": "2026-10-01",
     "assets": {
       "directory": "./dist",
       "binding": "ASSETS",
       "run_worker_first": true,
       "not_found_handling": "single-page-application"
     },
     "vars": {
       "AUTH_GAS_URL": "TEMPEL_URL_EXEC_AUTH_GATEWAY_DI_SINI"
     }
   }
