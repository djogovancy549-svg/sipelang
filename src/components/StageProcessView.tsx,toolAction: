import React, { useState } from 'react';
import {
  ProcurementPackage,
  StageKey,
  DocumentItem,
  ReviewStatus,
  ReviewMatrixItem,
  ReviewerRoleType,
  DocumentChecklistItem,
} from '../types/procurement';
import { PROCUREMENT_STAGES, getDefaultDocumentChecklist } from '../data/procurementStages';
import { formatRupiah, getProcurementTypeLabel, formatDate } from '../utils/formatters';
import { ReviewMatrixModal } from './ReviewMatrixModal';
import { MainNavTab } from './Sidebar';
import {
  CheckCircle2,
  Clock,
  AlertCircle,
  GitMerge,
  CheckSquare,
  Square,
  ChevronRight,
  Save,
  FileText,
  ShieldCheck,
  ExternalLink,
  PlusCircle,
  Eye,
  Check,
  AlertTriangle,
  LayoutGrid,
  Table,
  Folder,
  Columns,
  Printer,
  X,
  FileCheck2,
  Building2,
  Calendar,
  UserCheck,
  Sparkles,
  Search,
} from 'lucide-react';

interface StageProcessViewProps {
  packages: ProcurementPackage[];
  documents?: DocumentItem[];
  onUpdatePackageStage: (updatedPkg: ProcurementPackage) => void;
  selectedPackageId?: string;
  onNavigateTab?: (tab: MainNavTab) => void;
  onOpenReviewDoc?: (doc: DocumentItem) => void;
  onUpdateDocumentReview?: (docId: string, status: ReviewStatus, notes: string) => void;
}

export const StageProcessView: React.FC<StageProcessViewProps> = ({
  packages,
  documents = [],
  onUpdatePackageStage,
  selectedPackageId: initialPkgId,
  onNavigateTab,
  onOpenReviewDoc,
  onUpdateDocumentReview,
}) => {
  const [activePkgId, setActivePkgId] = useState<string>(
    initialPkgId || (packages[0]?.id || '')
  );

  // Main Mode: 'CHECKLIST' (Primary Ceklist Dokumen Pengadaan) or 'STEPPER' (Alur 6 Tahapan)
  const [mainMode, setMainMode] = useState<'CHECKLIST' | 'STEPPER'>('CHECKLIST');

  // Stepper Stage Key
  const [activeStageKey, setActiveStageKey] = useState<StageKey>('PERSIAPAN_PPK');
  const [editNotes, setEditNotes] = useState('');

  // Selected document for direct inside-modal review
  const [modalReviewDoc, setModalReviewDoc] = useState<DocumentItem | null>(null);

  // Print Modal State for Ceklist Dokumen
  const [isPrintModalOpen, setIsPrintModalOpen] = useState(false);

  // View modes for stage document panel: CARD, TABLE, ICON, SPLIT
  const [docViewMode, setDocViewMode] = useState<'CARD' | 'TABLE' | 'ICON' | 'SPLIT'>('CARD');
  const [splitDocId, setSplitDocId] = useState<string | null>(null);

  const currentPkg = packages.find((p) => p.id === activePkgId) || packages[0];

  React.useEffect(() => {
    if (currentPkg) {
      setActiveStageKey(currentPkg.currentStage);
      const stageData = currentPkg.stages[currentPkg.currentStage];
      setEditNotes(stageData?.notes || '');
    }
  }, [currentPkg?.id]);

  if (!currentPkg) {
    return (
      <div className="bg-white border border-stone-200/90 rounded-2xl p-12 text-center text-stone-500 space-y-3 shadow-xs">
        <GitMerge className="w-10 h-10 text-stone-300 mx-auto" />
        <h3 className="font-bold text-stone-700 text-sm">Belum Ada Paket Pengadaan Terdaftar</h3>
        <p className="text-xs text-stone-500 max-w-md mx-auto">
          Silakan buat paket pengadaan baru terlebih dahulu melalui menu "Kelola Paket" atau tombol "+ Buat Paket".
        </p>
      </div>
    );
  }

  // Ensure documentChecklist is populated
  const activeChecklist: DocumentChecklistItem[] =
    currentPkg.documentChecklist && currentPkg.documentChecklist.length > 0
      ? currentPkg.documentChecklist
      : getDefaultDocumentChecklist();

  const typeBadge = getProcurementTypeLabel(currentPkg.procurementType);

  // Toggle Ceklist Dokumen Item
  const handleToggleChecklistItem = (item: DocumentChecklistItem) => {
    const updatedList = activeChecklist.map((c) => {
      if (c.id === item.id) {
        return {
          ...c,
          isDone: !c.isDone,
          date: !c.isDone && !c.date ? new Date().toISOString().slice(0, 10) : c.date,
        };
      }
      return c;
    });

    const doneCount = updatedList.filter((c) => c.isDone).length;
    const progressPercent = Math.round((doneCount / updatedList.length) * 100);

    const updatedPackage: ProcurementPackage = {
      ...currentPkg,
      documentChecklist: updatedList,
      overallProgress: progressPercent,
    };

    onUpdatePackageStage(updatedPackage);
  };

  // Update Checklist Item Fields (Number, Date, Notes)
  const handleUpdateChecklistItemDetails = (
    itemId: string,
    field: 'documentNumber' | 'date' | 'notes' | 'verifiedBy',
    value: string
  ) => {
    const updatedList = activeChecklist.map((c) => {
      if (c.id === itemId) {
        return {
          ...c,
          [field]: value,
        };
      }
      return c;
    });

    const updatedPackage: ProcurementPackage = {
      ...currentPkg,
      documentChecklist: updatedList,
    };

    onUpdatePackageStage(updatedPackage);
  };

  // Helper for Stepper
  const currentStageInfo = PROCUREMENT_STAGES.find((s) => s.key === activeStageKey)!;
  const currentStageState = currentPkg.stages[activeStageKey];

  const getDocumentsForCurrentStage = (): DocumentItem[] => {
    const pkgDocs = documents.filter((d) => d.packageId === currentPkg.id);
    if (pkgDocs.length === 0) return [];

    switch (activeStageKey) {
      case 'PERSIAPAN_PPK':
        return pkgDocs.filter(
          (d) =>
            d.category === 'PERSIAPAN' ||
            d.title.toLowerCase().includes('kak') ||
            d.title.toLowerCase().includes('hps')
        );
      case 'PERMINTAAN_PENAWARAN':
        return pkgDocs.filter(
          (d) =>
            d.category === 'PENAWARAN' ||
            d.title.toLowerCase().includes('permintaan') ||
            d.title.toLowerCase().includes('undangan')
        );
      case 'EVALUASI_PENAWARAN':
        return pkgDocs.filter(
          (d) =>
            d.category === 'PENAWARAN' ||
            d.category === 'EVALUASI_NEGOSIASI' ||
            d.title.toLowerCase().includes('penawaran') ||
            d.title.toLowerCase().includes('evaluasi')
        );
      case 'KLARIFIKASI_NEGOSIASI':
        return pkgDocs.filter(
          (d) =>
            d.category === 'EVALUASI_NEGOSIASI' ||
            d.title.toLowerCase().includes('klarifikasi') ||
            d.title.toLowerCase().includes('negosiasi')
        );
      case 'PENETAPAN_BAHPL':
        return pkgDocs.filter(
          (d) =>
            d.category === 'EVALUASI_NEGOSIASI' ||
            d.category === 'KONTRAK_HASIL' ||
            d.title.toLowerCase().includes('bahpl') ||
            d.title.toLowerCase().includes('penetapan')
        );
      case 'SPK_SELESAI':
        return pkgDocs.filter(
          (d) =>
            d.category === 'KONTRAK_HASIL' ||
            d.category === 'SERAH_TERIMA' ||
            d.title.toLowerCase().includes('spk') ||
            d.title.toLowerCase().includes('bast')
        );
      default:
        return pkgDocs;
    }
  };

  const stageDocs = getDocumentsForCurrentStage();
  const displayDocs = stageDocs.length > 0 ? stageDocs : documents.filter((d) => d.packageId === currentPkg.id);
  const activeSplitDoc = displayDocs.find((d) => d.id === splitDocId) || displayDocs[0];

  const handleAdvanceStage = () => {
    const stageIndex = PROCUREMENT_STAGES.findIndex((s) => s.key === activeStageKey);
    const updatedStages = { ...currentPkg.stages };

    updatedStages[activeStageKey] = {
      ...updatedStages[activeStageKey],
      status: 'completed',
      completedDate: new Date().toISOString().slice(0, 10),
      notes: editNotes || updatedStages[activeStageKey].notes,
      checklists: updatedStages[activeStageKey].checklists.map((c) => ({ ...c, isDone: true })),
    };

    let nextStageKey = currentPkg.currentStage;
    if (stageIndex < PROCUREMENT_STAGES.length - 1) {
      nextStageKey = PROCUREMENT_STAGES[stageIndex + 1].key;
      updatedStages[nextStageKey] = {
        ...updatedStages[nextStageKey],
        status: 'in_progress',
        startDate: new Date().toISOString().slice(0, 10),
      };
      setActiveStageKey(nextStageKey);
    }

    const allChecklists = Object.values(updatedStages).flatMap((s) => s.checklists);
    const totalDone = allChecklists.filter((c) => c.isDone).length;
    const newProgress = Math.min(100, Math.round((totalDone / Math.max(1, allChecklists.length)) * 100));

    const updatedPackage: ProcurementPackage = {
      ...currentPkg,
      currentStage: nextStageKey,
      overallProgress: newProgress,
      stages: updatedStages,
      notes: editNotes ? editNotes : currentPkg.notes,
    };

    onUpdatePackageStage(updatedPackage);
  };

  const handleSaveMatrixEvaluation = (
    docId: string,
    newStatus: ReviewStatus,
    summaryNotes: string,
    _items: ReviewMatrixItem[],
    _reviewerName: string,
    _reviewerRole: ReviewerRoleType
  ) => {
    if (onUpdateDocumentReview) {
      onUpdateDocumentReview(docId, newStatus, summaryNotes);
    }
  };

  // Count done
  const completedChecklistCount = activeChecklist.filter((c) => c.isDone).length;

  return (
    <div className="space-y-6 animate-fade-in pb-10">
      {/* 1. TOP BAR & PACKAGE SELECTOR */}
      <div className="bg-white border border-stone-200/90 rounded-2xl p-4 sm:p-5 shadow-sm space-y-4">
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div className="flex items-center gap-2 flex-wrap mb-1">
              <span className="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-[#701524] text-white uppercase font-mono tracking-wider">
                PEJABAT PENGADAAN (PP)
              </span>
              <span className="text-xs font-semibold text-stone-500">
                Dokumen Kelengkapan Pengadaan Langsung
              </span>
            </div>
            <h1 className="text-xl font-black text-stone-900 tracking-tight">
              Ceklist Kelengkapan Dokumen Pengadaan
            </h1>
            <p className="text-xs text-stone-600 mt-0.5">
              Lembar kontrol verifikasi fisik & digital 8 dokumen utama pengadaan langsung yang diisi oleh Pejabat Pengadaan.
            </p>
          </div>

          <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
            <div className="flex items-center gap-2 bg-stone-50 p-2 rounded-xl border border-stone-200">
              <label className="text-xs font-extrabold text-stone-700 shrink-0 pl-1">Pilih Paket:</label>
              <select
                value={activePkgId}
                onChange={(e) => setActivePkgId(e.target.value)}
                className="py-1.5 px-3 text-xs bg-white border border-stone-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#701524] font-bold text-stone-800 cursor-pointer max-w-xs"
              >
                {packages.map((pkg) => (
                  <option key={pkg.id} value={pkg.id}>
                    [{pkg.procurementType}] {pkg.name.slice(0, 35)}...
                  </option>
                ))}
              </select>
            </div>

            <button
              onClick={() => setIsPrintModalOpen(true)}
              className="px-4 py-2.5 bg-[#701524] hover:bg-[#58101c] text-white font-extrabold text-xs rounded-xl transition-all shadow-md shadow-[#701524]/20 flex items-center justify-center gap-2 cursor-pointer active:scale-95"
            >
              <Printer className="w-4 h-4 text-rose-200" />
              <span>CETAK FORM CEKLIST</span>
            </button>
          </div>
        </div>

        {/* PACKAGE SUMMARY STRIP */}
        <div className="p-4 bg-stone-50 rounded-2xl border border-stone-200 space-y-2 text-xs">
          <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div className="space-y-0.5">
              <div className="flex items-center gap-2 flex-wrap">
                <span className={`text-[10px] font-bold px-2 py-0.5 rounded border ${typeBadge.badgeClass}`}>
                  {typeBadge.label}
                </span>
                <span className="font-mono text-stone-500 font-bold">REG: {currentPkg.registerNumber || currentPkg.codeRUP}</span>
                <span className="text-stone-300">•</span>
                <span className="font-bold text-stone-700">{currentPkg.skpdName}</span>
              </div>
              <h2 className="text-sm font-black text-stone-900 leading-snug">{currentPkg.name}</h2>
            </div>

            <div className="text-left sm:text-right shrink-0">
              <div className="text-stone-500 text-[10px] font-semibold">Nilai HPS:</div>
              <div className="font-mono text-base font-black text-stone-900">{formatRupiah(currentPkg.hpsValue)}</div>
            </div>
          </div>

          <div className="pt-2 border-t border-stone-200/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-[11px] text-stone-600">
            <div className="flex items-center gap-4 flex-wrap">
              <span>Pejabat Pengadaan: <strong className="text-stone-900">{currentPkg.ppName}</strong></span>
              <span>PPK: <strong className="text-stone-900">{currentPkg.ppkName}</strong></span>
              <span>Penyedia: <strong className="text-stone-900">{currentPkg.vendorName}</strong></span>
            </div>

            {/* Progress Bar Indicator */}
            <div className="flex items-center gap-2 w-full sm:w-auto">
              <span className="font-bold text-[#701524] font-mono shrink-0">
                {completedChecklistCount}/8 Dokumen Lengkap ({Math.round((completedChecklistCount / 8) * 100)}%)
              </span>
              <div className="w-24 h-2.5 bg-stone-200 rounded-full overflow-hidden shrink-0">
                <div
                  className="h-full bg-gradient-to-r from-[#701524] to-emerald-600 transition-all duration-300"
                  style={{ width: `${(completedChecklistCount / 8) * 100}%` }}
                />
              </div>
            </div>
          </div>
        </div>

        {/* MODE SWITCHER TAB */}
        <div className="flex items-center gap-2 bg-stone-100 p-1 rounded-xl border border-stone-200">
          <button
            onClick={() => setMainMode('CHECKLIST')}
            className={`flex-1 py-2 px-3 rounded-lg text-xs font-extrabold transition-all flex items-center justify-center gap-2 cursor-pointer ${
              mainMode === 'CHECKLIST'
                ? 'bg-[#701524] text-white shadow-xs'
                : 'text-stone-600 hover:bg-stone-200/60'
            }`}
          >
            <CheckSquare className="w-4 h-4" />
            <span>1. CEKLIST KELENGKAPAN DOKUMEN PENGADAAN (UTAMA)</span>
          </button>

          <button
            onClick={() => setMainMode('STEPPER')}
            className={`flex-1 py-2 px-3 rounded-lg text-xs font-extrabold transition-all flex items-center justify-center gap-2 cursor-pointer ${
              mainMode === 'STEPPER'
                ? 'bg-[#701524] text-white shadow-xs'
                : 'text-stone-600 hover:bg-stone-200/60'
            }`}
          >
            <Clock className="w-4 h-4" />
            <span>2. DETAIL ALUR 6 TAHAPAN & VERIFIKASI DOKUMEN</span>
          </button>
        </div>
      </div>

      {/* MODE 1: FORM CEKLIST KELENGKAPAN DOKUMEN PENGADAAN (STRICT GOVERNMENT TABLE FORMAT) */}
      {mainMode === 'CHECKLIST' && (
        <div className="bg-white border-2 border-stone-900 rounded-2xl p-4 sm:p-6 shadow-md space-y-5">
          {/* Header Box formatted strictly like the official document image */}
          <div className="border-2 border-stone-900 text-center font-bold divide-y-2 divide-stone-900">
            <div className="py-2 bg-stone-100 text-xs sm:text-sm uppercase tracking-wider text-stone-900">
              Jenis Pengadaan
            </div>
            <div className="py-2.5 bg-white text-base sm:text-lg text-stone-900 uppercase font-black tracking-wide">
              {currentPkg.procurementType === 'KONSTRUKSI'
                ? 'Pekerjaan Konstruksi'
                : currentPkg.procurementType === 'KONSULTANSI'
                ? 'Jasa Konsultansi Konstruksi'
                : 'Pengadaan Barang / Jasa Lainnya'}
            </div>
            <div className="py-2 bg-stone-100 text-xs sm:text-sm uppercase tracking-wider text-stone-900">
              Ceklist Dokumen Pengadaan Langsung
            </div>
          </div>

          {/* Interactive Checklist Table */}
          <div className="border-2 border-stone-900 overflow-x-auto">
            <table className="w-full text-left text-xs border-collapse">
              <thead>
                <tr className="bg-stone-100 text-stone-900 font-black border-b-2 border-stone-900 divide-x-2 divide-stone-900">
                  <th className="p-3 text-center w-12">No.</th>
                  <th className="p-3">Ceklist Dokumen Pengadaan</th>
                  <th className="p-3 text-center w-28">Kelengkapan (√)</th>
                  <th className="p-3 w-64">No. Surat & Tanggal Dokumen</th>
                  <th className="p-3 w-48">Aksi Verifikasi</th>
                </tr>
              </thead>
              <tbody className="divide-y-2 divide-stone-900 text-stone-900">
                {activeChecklist.map((item, index) => {
                  return (
                    <tr
                      key={item.id}
                      className={`divide-x-2 divide-stone-900 transition-colors ${
                        item.isDone ? 'bg-emerald-50/40' : 'hover:bg-stone-50'
                      }`}
                    >
                      {/* Number */}
                      <td className="p-3 text-center font-mono font-bold text-sm text-stone-900">
                        {index + 1}
                      </td>

                      {/* Title & Guidance */}
                      <td className="p-3 space-y-1">
                        <div className="font-extrabold text-xs sm:text-sm text-stone-900 leading-snug">
                          {item.title}
                        </div>
                        <input
                          type="text"
                          placeholder="Tambah catatan/keterangan dokumen..."
                          value={item.notes || ''}
                          onChange={(e) =>
                            handleUpdateChecklistItemDetails(item.id, 'notes', e.target.value)
                          }
                          className="w-full px-2 py-1 text-[11px] border border-stone-300 rounded bg-white text-stone-800 focus:outline-none focus:ring-1 focus:ring-[#701524]"
                        />
                      </td>

                      {/* Checkmark Column */}
                      <td className="p-3 text-center">
                        <button
                          type="button"
                          onClick={() => handleToggleChecklistItem(item)}
                          className={`w-10 h-10 mx-auto rounded-xl border-2 flex items-center justify-center transition-all cursor-pointer font-black text-xl shadow-xs active:scale-95 ${
                            item.isDone
                              ? 'bg-emerald-700 text-white border-emerald-900 shadow-emerald-700/30'
                              : 'bg-white text-stone-300 border-stone-400 hover:border-stone-700'
                          }`}
                          title={item.isDone ? 'Klik untuk membatalkan centang' : 'Klik untuk menandai lengkap √'}
                        >
                          {item.isDone ? '√' : ''}
                        </button>
                      </td>

                      {/* Document Number & Date inputs */}
                      <td className="p-3 space-y-1.5">
                        <div>
                          <label className="text-[10px] font-mono text-stone-500 font-bold block">No. Surat:</label>
                          <input
                            type="text"
                            placeholder="Misal: 027/01/UND-PL/PUPR/2026"
                            value={item.documentNumber || ''}
                            onChange={(e) =>
                              handleUpdateChecklistItemDetails(item.id, 'documentNumber', e.target.value)
                            }
                            className="w-full px-2 py-1 text-xs font-mono border border-stone-300 rounded bg-white font-bold text-stone-900 focus:outline-none focus:ring-1 focus:ring-[#701524]"
                          />
                        </div>
                        <div>
                          <label className="text-[10px] font-mono text-stone-500 font-bold block">Tanggal:</label>
                          <input
                            type="date"
                            value={item.date || ''}
                            onChange={(e) =>
                              handleUpdateChecklistItemDetails(item.id, 'date', e.target.value)
                            }
                            className="w-full px-2 py-1 text-xs font-mono border border-stone-300 rounded bg-white text-stone-900 focus:outline-none focus:ring-1 focus:ring-[#701524]"
                          />
                        </div>
                      </td>

                      {/* Action */}
                      <td className="p-3 space-y-2">
                        <button
                          type="button"
                          onClick={() => handleToggleChecklistItem(item)}
                          className={`w-full py-1.5 px-2.5 rounded-lg text-xs font-extrabold transition-all flex items-center justify-center gap-1.5 cursor-pointer ${
                            item.isDone
                              ? 'bg-emerald-100 text-emerald-900 border border-emerald-300 hover:bg-emerald-200'
                              : 'bg-[#701524] text-white hover:bg-[#58101c]'
                          }`}
                        >
                          {item.isDone ? (
                            <>
                              <Check className="w-3.5 h-3.5" />
                              <span>Verified (√)</span>
                            </>
                          ) : (
                            <>
                              <CheckSquare className="w-3.5 h-3.5" />
                              <span>Tandai Lengkap</span>
                            </>
                          )}
                        </button>

                        <div className="text-[10px] text-stone-500 font-mono text-center">
                          Oleh: {item.verifiedBy || 'Pejabat Pengadaan'}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Table Footer Actions */}
          <div className="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-stone-200">
            <div className="text-xs text-stone-600 font-semibold">
              Status Ceklist: <span className="font-bold text-[#701524]">{completedChecklistCount} dari 8 dokumen telah terverifikasi lengkap.</span>
            </div>

            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={() => setIsPrintModalOpen(true)}
                className="px-5 py-2.5 bg-[#701524] hover:bg-[#58101c] text-white font-black text-xs rounded-xl transition-all shadow-md flex items-center gap-2 cursor-pointer active:scale-95"
              >
                <Printer className="w-4 h-4 text-rose-200" />
                <span>CETAK FORM KELENGKAPAN (PDF/PRINT)</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODE 2: STEPPER ALUR 6 TAHAPAN (EXISTING FULL MONITORING WORKBENCH) */}
      {mainMode === 'STEPPER' && (
        <div className="space-y-5">
          {/* 6-Step Visual Stepper */}
          <div className="bg-white border border-stone-200/90 rounded-2xl p-4 shadow-xs space-y-3">
            <h3 className="font-extrabold text-xs text-stone-900 uppercase tracking-wider">
              Kemajuan 6 Tahapan Proses Pengadaan Langsung
            </h3>
            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2">
              {PROCUREMENT_STAGES.map((stage) => {
                const stageData = currentPkg.stages[stage.key];
                const isCurrentActive = activeStageKey === stage.key;
                const isCompleted = stageData?.status === 'completed';
                const isInProgress = stageData?.status === 'in_progress';

                let borderClass = 'border-stone-200 bg-stone-50/60 text-stone-600';
                let iconBadge = <span className="font-mono text-[10px]">{stage.stepNumber}</span>;

                if (isCompleted) {
                  borderClass = 'border-emerald-300 bg-emerald-50/50 text-emerald-900';
                  iconBadge = <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" />;
                } else if (isInProgress) {
                  borderClass = 'border-[#701524] bg-rose-50/50 text-[#701524] font-semibold';
                  iconBadge = <Clock className="w-3.5 h-3.5 text-[#701524]" />;
                }

                return (
                  <button
                    key={stage.key}
                    onClick={() => {
                      setActiveStageKey(stage.key);
                      setEditNotes(currentPkg.stages[stage.key]?.notes || '');
                    }}
                    className={`p-2.5 rounded-xl border text-left transition-all relative flex flex-col justify-between ${borderClass} ${
                      isCurrentActive ? 'ring-2 ring-[#701524] border-[#701524] shadow-xs' : 'hover:border-stone-300'
                    }`}
                  >
                    <div className="flex items-center justify-between mb-1">
                      <div className="w-5 h-5 rounded-full bg-white border border-stone-200 flex items-center justify-center font-bold">
                        {iconBadge}
                      </div>
                      <span className="text-[9px] font-mono uppercase text-stone-500 font-bold">
                        {isCompleted ? 'Selesai' : isInProgress ? 'Aktif' : 'Antre'}
                      </span>
                    </div>
                    <div>
                      <h4 className="font-bold text-xs leading-tight line-clamp-1">{stage.shortTitle}</h4>
                    </div>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Stepper Details Grid */}
          <div className="grid grid-cols-1 xl:grid-cols-12 gap-5">
            {/* Stage Checklists */}
            <div className="xl:col-span-5 bg-white border border-stone-200/90 rounded-2xl shadow-xs p-5 space-y-4">
              <div className="pb-3 border-b border-stone-100 flex items-center justify-between gap-3">
                <div>
                  <div className="flex items-center gap-2">
                    <span className="w-6 h-6 rounded-full bg-[#701524] text-white flex items-center justify-center text-xs font-bold font-mono">
                      {currentStageInfo.stepNumber}
                    </span>
                    <h3 className="font-extrabold text-sm text-stone-900">
                      {currentStageInfo.title}
                    </h3>
                  </div>
                  <p className="text-xs text-stone-500 mt-1">
                    {currentStageInfo.description}
                  </p>
                </div>
              </div>

              <div className="space-y-2">
                <h4 className="text-[11px] font-bold uppercase tracking-wider text-stone-500 flex items-center gap-1.5">
                  <CheckSquare className="w-3.5 h-3.5 text-[#701524]" />
                  <span>Kriteria Verifikasi Tahapan</span>
                </h4>

                {currentStageState?.checklists.map((check) => (
                  <div
                    key={check.id}
                    className={`p-3 rounded-xl border transition-all flex items-start gap-3 ${
                      check.isDone
                        ? 'border-emerald-300 bg-emerald-50/30 text-stone-900'
                        : 'border-stone-200 bg-white text-stone-800'
                    }`}
                  >
                    <div className="pt-0.5 shrink-0">
                      {check.isDone ? (
                        <CheckCircle2 className="w-4 h-4 text-emerald-600" />
                      ) : (
                        <Square className="w-4 h-4 text-stone-300" />
                      )}
                    </div>
                    <div className="flex-1 text-xs space-y-1">
                      <span className="font-semibold text-stone-900 leading-snug block">
                        {check.text}
                      </span>
                    </div>
                  </div>
                ))}
              </div>

              <div className="pt-3 border-t border-stone-100 flex justify-end">
                <button
                  type="button"
                  onClick={handleAdvanceStage}
                  className="px-4 py-2 bg-[#701524] hover:bg-[#58101c] text-white text-xs font-extrabold rounded-xl transition-all shadow-xs flex items-center gap-1.5 cursor-pointer"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>Selesaikan & Lanjut Tahap</span>
                  <ChevronRight className="w-4 h-4" />
                </button>
              </div>
            </div>

            {/* Stage Documents Panel */}
            <div className="xl:col-span-7 bg-white border border-stone-200/90 rounded-2xl shadow-xs p-5 space-y-4">
              <div className="flex items-center justify-between pb-3 border-b border-stone-100">
                <h3 className="font-bold text-xs uppercase tracking-wider text-stone-800 flex items-center gap-2">
                  <FileText className="w-4 h-4 text-[#701524]" />
                  <span>Berkas Dokumen Tahap Ini ({displayDocs.length})</span>
                </h3>

                {onNavigateTab && (
                  <button
                    type="button"
                    onClick={() => onNavigateTab('unggah-dokumen')}
                    className="text-xs text-[#701524] hover:underline font-bold flex items-center gap-1 cursor-pointer"
                  >
                    <PlusCircle className="w-3.5 h-3.5" />
                    <span>+ Unggah Dokumen</span>
                  </button>
                )}
              </div>

              {displayDocs.length === 0 ? (
                <div className="p-8 border border-dashed border-stone-200 rounded-xl bg-stone-50 text-center space-y-2">
                  <FileText className="w-8 h-8 text-stone-300 mx-auto" />
                  <p className="text-xs text-stone-500 font-medium">
                    Belum ada dokumen terunggah untuk tahap ini.
                  </p>
                </div>
              ) : (
                <div className="space-y-2.5 max-h-[380px] overflow-y-auto pr-1">
                  {displayDocs.map((doc) => (
                    <div
                      key={doc.id}
                      className="p-3 border border-stone-200 rounded-xl bg-stone-50/50 flex items-center justify-between gap-2"
                    >
                      <div className="min-w-0">
                        <span className="text-[9px] font-mono font-bold uppercase px-1.5 py-0.2 rounded bg-stone-200 text-stone-700">
                          {doc.category}
                        </span>
                        <h4 className="font-bold text-xs text-stone-900 truncate">{doc.title}</h4>
                        <p className="text-[10px] text-stone-400 font-mono">{doc.fileName}</p>
                      </div>

                      <button
                        type="button"
                        onClick={() => setModalReviewDoc(doc)}
                        className="px-2.5 py-1.5 bg-[#701524] text-white font-bold text-[11px] rounded-lg transition-colors flex items-center gap-1 cursor-pointer shrink-0"
                      >
                        <ShieldCheck className="w-3.5 h-3.5 text-rose-200" />
                        <span>Matriks</span>
                      </button>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Embedded Review Matrix Modal */}
      {modalReviewDoc && (
        <ReviewMatrixModal
          isOpen={!!modalReviewDoc}
          onClose={() => setModalReviewDoc(null)}
          document={modalReviewDoc}
          procurementPackage={currentPkg}
          onSaveEvaluation={handleSaveMatrixEvaluation}
        />
      )}

      {/* PRINT MODAL CEKLIST KELENGKAPAN DOKUMEN PENGADAAN */}
      {isPrintModalOpen && (
        <div className="fixed inset-0 bg-stone-950/80 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-fade-in overflow-y-auto">
          <div className="bg-white rounded-2xl max-w-4xl w-full shadow-2xl border border-stone-300 overflow-hidden my-8 flex flex-col">
            {/* Modal Header Toolbar */}
            <div className="bg-stone-900 text-white p-4 flex items-center justify-between no-print">
              <div className="flex items-center gap-2">
                <Printer className="w-5 h-5 text-rose-400" />
                <span className="font-bold text-sm">Cetak Ceklist Kelengkapan Dokumen Pengadaan</span>
              </div>
              <div className="flex items-center gap-2">
                <button
                  onClick={() => window.print()}
                  className="px-4 py-1.5 bg-[#701524] hover:bg-[#58101c] text-white text-xs font-bold rounded-lg transition-all flex items-center gap-1.5 cursor-pointer"
                >
                  <Printer className="w-3.5 h-3.5" />
                  <span>Cetak / Cetak PDF</span>
                </button>
                <button
                  onClick={() => setIsPrintModalOpen(false)}
                  className="p-1.5 rounded-lg text-stone-400 hover:text-white hover:bg-stone-800 transition-colors cursor-pointer"
                >
                  <X className="w-5 h-5" />
                </button>
              </div>
            </div>

            {/* Printable Paper Content */}
            <div className="p-8 sm:p-12 space-y-6 text-stone-900 font-serif leading-relaxed bg-white text-xs sm:text-sm">
              {/* Kop Surat Official */}
              <div className="text-center border-b-4 border-double border-stone-900 pb-3 space-y-1">
                <h3 className="font-black text-sm sm:text-base uppercase tracking-wider">
                  PEMERINTAH KABUPATEN NAGEKEO
                </h3>
                <h2 className="font-black text-base sm:text-xl uppercase tracking-wide">
                  DINAS PEKERJAAN UMUM DAN PENATAAN RUANG
                </h2>
                <p className="text-[11px] font-sans text-stone-700 italic">
                  Jln. Mawar No. 02 Kompleks Perkantoran Civic Center Mbay - Nagekeo, Flores - NTT
                </p>
              </div>

              {/* Title Header */}
              <div className="text-center space-y-1">
                <h2 className="font-black text-base sm:text-lg underline uppercase tracking-wide">
                  CEKLIST KELENGKAPAN DOKUMEN PENGADAAN LANGSUNG
                </h2>
                <p className="font-mono text-xs font-bold text-stone-700">
                  Nomor Register: {currentPkg.registerNumber || currentPkg.codeRUP}
                </p>
              </div>

              {/* Package Identification Details */}
              <div className="border border-stone-900 p-3 space-y-1 font-sans text-xs bg-stone-50/50">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <div>
                    <span className="font-bold text-stone-700">Nama Paket:</span>{' '}
                    <span className="font-black">{currentPkg.name}</span>
                  </div>
                  <div>
                    <span className="font-bold text-stone-700">Jenis Pengadaan:</span>{' '}
                    <span className="font-bold">{currentPkg.procurementType}</span>
                  </div>
                  <div>
                    <span className="font-bold text-stone-700">SKPD / Dinas:</span>{' '}
                    <span>{currentPkg.skpdName}</span>
                  </div>
                  <div>
                    <span className="font-bold text-stone-700">Nilai HPS:</span>{' '}
                    <span className="font-mono font-bold">{formatRupiah(currentPkg.hpsValue)}</span>
                  </div>
                  <div>
                    <span className="font-bold text-stone-700">Pejabat Pengadaan:</span>{' '}
                    <span>{currentPkg.ppName}</span>
                  </div>
                  <div>
                    <span className="font-bold text-stone-700">Pejabat Pembuat Komitmen:</span>{' '}
                    <span>{currentPkg.ppkName}</span>
                  </div>
                </div>
              </div>

              {/* Strict Government Checklist Table */}
              <div className="border-2 border-stone-900 overflow-hidden font-sans">
                <div className="border-b-2 border-stone-900 text-center font-bold divide-y-2 divide-stone-900">
                  <div className="py-1.5 bg-stone-100 text-xs uppercase font-bold">
                    Jenis Pengadaan
                  </div>
                  <div className="py-2 bg-white text-sm font-black uppercase tracking-wide">
                    {currentPkg.procurementType === 'KONSTRUKSI'
                      ? 'Pekerjaan Konstruksi'
                      : currentPkg.procurementType === 'KONSULTANSI'
                      ? 'Jasa Konsultansi Konstruksi'
                      : 'Pengadaan Barang / Jasa Lainnya'}
                  </div>
                  <div className="py-1.5 bg-stone-100 text-xs uppercase font-bold">
                    Ceklist Dokumen
                  </div>
                </div>

                <table className="w-full text-left text-xs border-collapse">
                  <thead>
                    <tr className="bg-stone-100 font-black border-b-2 border-stone-900 divide-x-2 divide-stone-900">
                      <th className="p-2 text-center w-10">No.</th>
                      <th className="p-2">Ceklist Dokumen</th>
                      <th className="p-2 text-center w-20">Kelengkapan (√)</th>
                      <th className="p-2 w-48">No. Surat & Tanggal</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-stone-900">
                    {activeChecklist.map((item, idx) => (
                      <tr key={item.id} className="divide-x-2 divide-stone-900">
                        <td className="p-2 text-center font-bold">{idx + 1}</td>
                        <td className="p-2 font-semibold">
                          {item.title}
                          {item.notes && (
                            <div className="text-[10px] text-stone-600 italic font-normal mt-0.5">
                              Ket: {item.notes}
                            </div>
                          )}
                        </td>
                        <td className="p-2 text-center font-black text-base">
                          {item.isDone ? '√' : ''}
                        </td>
                        <td className="p-2 font-mono text-[11px]">
                          <div>{item.documentNumber || '-'}</div>
                          <div className="text-stone-600">{item.date ? formatDate(item.date) : '-'}</div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Signature Block */}
              <div className="pt-8 grid grid-cols-2 gap-8 text-center font-sans text-xs">
                <div>
                  <p className="font-bold">Pejabat Pembuat Komitmen (PPK)</p>
                  <p className="text-[10px] text-stone-500">Dinas PUPR Kabupaten Nagekeo</p>
                  <div className="h-20" />
                  <p className="font-black underline uppercase">{currentPkg.ppkName}</p>
                  <p className="font-mono text-[10px]">NIP. 19780512 200501 1 008</p>
                </div>

                <div>
                  <p className="font-bold">Mbay, {formatDate(new Date().toISOString().slice(0, 10))}</p>
                  <p className="font-bold">Pejabat Pengadaan (PP)</p>
                  <p className="text-[10px] text-stone-500">Kabupaten Nagekeo</p>
                  <div className="h-16" />
                  <p className="font-black underline uppercase">{currentPkg.ppName}</p>
                  <p className="font-mono text-[10px]">NIP. 19840210 200902 1 003</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
